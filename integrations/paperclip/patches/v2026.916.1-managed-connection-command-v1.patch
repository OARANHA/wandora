+import { randomUUID } from "node:crypto";
+import { mkdirSync, rmSync } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { eq, inArray } from "drizzle-orm";
+import {
+  companies,
+  companySecrets,
+  companySecretVersions,
+  connectionGrants,
+  createDb,
+  toolAccessAuditEvents,
+  toolApplications,
+  toolConnections,
+  toolStdioCommandTemplates,
+} from "@paperclipai/db";
+import { buildHostServices } from "../services/plugin-host-services.js";
+import { secretService } from "../services/secrets.js";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+const DECLARATION_KEY = "wandora.28pro.vendaerp-readonly-v1";
+const APPLICATION_KEY = "wandora.vendaerp-readonly-v1";
+const TEMPLATE_KEY = "wandora.vendaerp-readonly-v1-r1";
+const ENV_KEYS = [
+  "VENDAERP_AUTHORIZATION_TOKEN",
+  "VENDAERP_USER",
+  "VENDAERP_APP",
+] as const;
+const TOOL_NAMES = [
+  "vendaerp_probe",
+  "vendaerp_list_companies",
+  "vendaerp_search_products",
+  "vendaerp_get_product_stock",
+  "vendaerp_list_price_tables",
+  "vendaerp_search_price_table_products",
+  "vendaerp_search_parties",
+  "vendaerp_search_orders",
+] as const;
+
+function createEventBusStub() {
+  return {
+    forPlugin() {
+      return {
+        emit: vi.fn(),
+        subscribe: vi.fn(),
+        clear: vi.fn(),
+      };
+    },
+  } as any;
+}
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported
+  ? describe
+  : describe.skip;
+
+async function seedDeclaredConnection(
+  db: ReturnType<typeof createDb>,
+  suffix: string,
+) {
+  const [company] = await db
+    .insert(companies)
+    .values({
+      name: "Managed Connection " + suffix,
+      issuePrefix: "MC" + randomUUID().slice(0, 6).toUpperCase(),
+    })
+    .returning();
+
+  const [application] = await db
+    .insert(toolApplications)
+    .values({
+      companyId: company!.id,
+      applicationKey: APPLICATION_KEY,
+      name: "28PRO VendaERP Read-Only V1",
+      type: "mcp_stdio",
+      status: "active",
+    })
+    .returning();
+
+  await db.insert(toolStdioCommandTemplates).values({
+    companyId: company!.id,
+    templateKey: TEMPLATE_KEY,
+    name: "28PRO VendaERP Read-Only V1",
+    status: "active",
+    command: "node",
+    args: [
+      "/opt/wandora/integrations/vendaerp-readonly-mcp/server.mjs",
+      "--tenant",
+      "voepro",
+    ],
+    envKeys: [...ENV_KEYS],
+    tools: TOOL_NAMES.map((name) => ({
+      name,
+      annotations: {
+        readOnlyHint: true,
+        destructiveHint: false,
+        openWorldHint: true,
+      },
+    })),
+  });
+
+  const secrets = secretService(db);
+  const authorization = await secrets.create(company!.id, {
+    name: "28PRO auth " + suffix,
+    key: "tool_app." + randomUUID() + ".env_VENDAERP_AUTHORIZATION_TOKEN",
+    provider: "local_encrypted",
+    value: "old-auth-" + suffix,
+  });
+  const user = await secrets.create(company!.id, {
+    name: "28PRO user " + suffix,
+    key: "tool_app." + randomUUID() + ".env_VENDAERP_USER",
+    provider: "local_encrypted",
+    value: "old-user-" + suffix,
+  });
+  const app = await secrets.create(company!.id, {
+    name: "28PRO app " + suffix,
+    key: "tool_app." + randomUUID() + ".env_VENDAERP_APP",
+    provider: "local_encrypted",
+    value: "old-app-" + suffix,
+  });
+
+  const refs = [
+    {
+      secretId: authorization.id,
+      versionSelector: "latest" as const,
+      configPath: "env.VENDAERP_AUTHORIZATION_TOKEN",
+      required: true,
+      label: "Authorization token",
+    },
+    {
+      secretId: user.id,
+      versionSelector: "latest" as const,
+      configPath: "env.VENDAERP_USER",
+      required: true,
+      label: "User",
+    },
+    {
+      secretId: app.id,
+      versionSelector: "latest" as const,
+      configPath: "env.VENDAERP_APP",
+      required: true,
+      label: "App",
+    },
+  ];
+
+  const [connection] = await db
+    .insert(toolConnections)
+    .values({
+      companyId: company!.id,
+      applicationId: application!.id,
+      name: "28PRO VendaERP Read-Only V1",
+      uid: "wandora-28pro/" + randomUUID(),
+      transport: "local_stdio",
+      ownership: "customer",
+      credentialSource: "paperclip_vault",
+      credentialPolicy: "shared",
+      status: "active",
+      enabled: true,
+      config: { templateId: TEMPLATE_KEY },
+      transportConfig: {},
+      credentialSecretRefs: refs,
+      healthStatus: "ok",
+    })
+    .returning();
+
+  const [grant] = await db
+    .insert(connectionGrants)
+    .values({
+      companyId: company!.id,
+      connectionId: connection!.id,
+      kind: "organization",
+      credentialSecretRefs: refs,
+      status: "active",
+      isDefault: true,
+    })
+    .returning();
+
+  return {
+    company: company!,
+    application: application!,
+    connection: connection!,
+    grant: grant!,
+    secrets: { authorization, user, app },
+  };
+}
+
+describeEmbeddedPostgres("plugin managed Connection command boundary", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null =
+    null;
+  const previousKeyFile = process.env.PAPERCLIP_SECRETS_MASTER_KEY_FILE;
+  const secretsTmpDir = path.join(
+    os.tmpdir(),
+    "paperclip-managed-connection-" + randomUUID(),
+  );
+
+  beforeAll(async () => {
+    mkdirSync(secretsTmpDir, { recursive: true });
+    process.env.PAPERCLIP_SECRETS_MASTER_KEY_FILE = path.join(
+      secretsTmpDir,
+      "master.key",
+    );
+    tempDb = await startEmbeddedPostgresTestDatabase(
+      "paperclip-managed-connection-",
+    );
+    db = createDb(tempDb.connectionString);
+  }, 20_000);
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+    if (previousKeyFile === undefined) {
+      delete process.env.PAPERCLIP_SECRETS_MASTER_KEY_FILE;
+    } else {
+      process.env.PAPERCLIP_SECRETS_MASTER_KEY_FILE = previousKeyFile;
+    }
+    rmSync(secretsTmpDir, { recursive: true, force: true });
+  });
+
+  function services() {
+    return buildHostServices(
+      db,
+      "plugin-record-id",
+      "wandora.organization-adapter-v1",
+      createEventBusStub(),
+    );
+  }
+
+  it("inspects and atomically replaces all three existing credentials without returning secret material", async () => {
+    const seeded = await seedDeclaredConnection(db, "success");
+    const host = services();
+    const values = {
+      authorizationToken: "new-auth-success",
+      user: "new-user-success",
+      app: "new-app-success",
+    };
+
+    try {
+      await expect(
+        host.toolAccess.manageDeclaredConnection({
+          companyId: seeded.company.id,
+          declarationKey: DECLARATION_KEY,
+          operation: "inspect",
+        }),
+      ).resolves.toEqual({
+        declarationKey: DECLARATION_KEY,
+        state: "connected",
+        healthStatus: "ok",
+        credentialsUpdated: false,
+      });
+
+      const result = await host.toolAccess.manageDeclaredConnection({
+        companyId: seeded.company.id,
+        declarationKey: DECLARATION_KEY,
+        operation: "replace_credentials",
+        credentialValues: values,
+      });
+      expect(result).toEqual({
+        declarationKey: DECLARATION_KEY,
+        state: "needs_attention",
+        healthStatus: "unchecked",
+        credentialsUpdated: true,
+      });
+
+      const ids = [
+        seeded.secrets.authorization.id,
+        seeded.secrets.user.id,
+        seeded.secrets.app.id,
+      ];
+      const rotated = await db
+        .select({
+          id: companySecrets.id,
+          latestVersion: companySecrets.latestVersion,
+        })
+        .from(companySecrets)
+        .where(inArray(companySecrets.id, ids));
+      expect(rotated).toHaveLength(3);
+      expect(rotated.every((row) => row.latestVersion === 2)).toBe(true);
+
+      const [connection] = await db
+        .select()
+        .from(toolConnections)
+        .where(eq(toolConnections.id, seeded.connection.id));
+      expect(connection!.healthStatus).toBe("unchecked");
+      expect(connection!.credentialSecretRefs).toEqual(
+        seeded.connection.credentialSecretRefs,
+      );
+
+      await expect(
+        host.toolAccess.manageDeclaredConnection({
+          companyId: seeded.company.id,
+          declarationKey: DECLARATION_KEY,
+          operation: "health",
+        }),
+      ).resolves.toEqual({
+        declarationKey: DECLARATION_KEY,
+        state: "connected",
+        healthStatus: "ok",
+        credentialsUpdated: false,
+      });
+
+      const versions = await db
+        .select()
+        .from(companySecretVersions)
+        .where(inArray(companySecretVersions.secretId, ids));
+      expect(versions).toHaveLength(6);
+
+      const audit = await db
+        .select()
+        .from(toolAccessAuditEvents)
+        .where(eq(toolAccessAuditEvents.connectionId, seeded.connection.id));
+      expect(audit).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            actorType: "plugin",
+            actorId: "wandora.organization-adapter-v1",
+            action: "tool_connection.credentials_replaced",
+            outcome: "success",
+          }),
+          expect.objectContaining({
+            action: "tool_connection.health_check",
+            outcome: "success",
+          }),
+        ]),
+      );
+
+      const serialized = JSON.stringify({
+        result,
+        connection,
+        versions: versions.map((version) => version.material),
+        audit,
+      });
+      expect(serialized).not.toContain(values.authorizationToken);
+      expect(serialized).not.toContain(values.user);
+      expect(serialized).not.toContain(values.app);
+      expect(serialized).not.toContain(seeded.secrets.authorization.id);
+      expect(JSON.stringify(result)).not.toMatch(
+        /secretId|connectionId|grantId|applicationId/i,
+      );
+    } finally {
+      host.dispose();
+    }
+  });
+
+  it("rolls back earlier rotations when the third secret version insert fails", async () => {
+    const seeded = await seedDeclaredConnection(db, "rollback");
+    await db.insert(companySecretVersions).values({
+      secretId: seeded.secrets.app.id,
+      version: 2,
+      material: { fixture: "preexisting-conflict" },
+      valueSha256: "fixture-value-sha",
+      fingerprintSha256: "fixture-fingerprint-sha",
+      status: "current",
+    });
+
+    const host = services();
+    try {
+      await expect(
+        host.toolAccess.manageDeclaredConnection({
+          companyId: seeded.company.id,
+          declarationKey: DECLARATION_KEY,
+          operation: "replace_credentials",
+          credentialValues: {
+            authorizationToken: "new-auth-rollback",
+            user: "new-user-rollback",
+            app: "new-app-rollback",
+          },
+        }),
+      ).rejects.toThrow();
+
+      const ids = [
+        seeded.secrets.authorization.id,
+        seeded.secrets.user.id,
+        seeded.secrets.app.id,
+      ];
+      const rows = await db
+        .select({
+          id: companySecrets.id,
+          latestVersion: companySecrets.latestVersion,
+        })
+        .from(companySecrets)
+        .where(inArray(companySecrets.id, ids));
+      expect(rows).toHaveLength(3);
+      expect(rows.every((row) => row.latestVersion === 1)).toBe(true);
+
+      const authVersions = await db
+        .select()
+        .from(companySecretVersions)
+        .where(
+          eq(
+            companySecretVersions.secretId,
+            seeded.secrets.authorization.id,
+          ),
+        );
+      const userVersions = await db
+        .select()
+        .from(companySecretVersions)
+        .where(eq(companySecretVersions.secretId, seeded.secrets.user.id));
+      expect(authVersions.map((row) => row.version)).toEqual([1]);
+      expect(userVersions.map((row) => row.version)).toEqual([1]);
+
+      const [connection] = await db
+        .select()
+        .from(toolConnections)
+        .where(eq(toolConnections.id, seeded.connection.id));
+      expect(connection!.healthStatus).toBe("ok");
+
+      const audit = await db
+        .select()
+        .from(toolAccessAuditEvents)
+        .where(eq(toolAccessAuditEvents.connectionId, seeded.connection.id));
+      expect(audit).toHaveLength(0);
+    } finally {
+      host.dispose();
+    }
+  });
+
+  it("fails closed on declaration mismatch and delegates disconnect to native removal", async () => {
+    const seeded = await seedDeclaredConnection(db, "disconnect");
+    const host = services();
+
+    try {
+      await expect(
+        host.toolAccess.manageDeclaredConnection({
+          companyId: seeded.company.id,
+          declarationKey: "wandora.unknown",
+          operation: "inspect",
+        }),
+      ).rejects.toThrow("Managed Connection declaration is not available");
+
+      const result = await host.toolAccess.manageDeclaredConnection({
+        companyId: seeded.company.id,
+        declarationKey: DECLARATION_KEY,
+        operation: "disconnect",
+      });
+      expect(result).toEqual({
+        declarationKey: DECLARATION_KEY,
+        state: "disconnected",
+        healthStatus: null,
+        credentialsUpdated: false,
+      });
+
+      const [connection] = await db
+        .select()
+        .from(toolConnections)
+        .where(eq(toolConnections.id, seeded.connection.id));
+      expect(connection!.status).toBe("archived");
