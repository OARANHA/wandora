@@ -0,0 +1,164 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  agents,
+  companies,
+  createDb,
+  heartbeatRuns,
+} from "@paperclipai/db";
+import { eq } from "drizzle-orm";
+import { buildHostServices } from "../services/plugin-host-services.js";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+function createEventBusStub() {
+  return {
+    forPlugin() {
+      return {
+        emit: vi.fn(),
+        subscribe: vi.fn(),
+        clear: vi.fn(),
+      };
+    },
+  } as any;
+}
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+describeEmbeddedPostgres("plugin agent-run read boundary", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-plugin-agent-run-read-");
+    db = createDb(tempDb.connectionString);
+  }, 20_000);
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  it("returns only a bounded same-company same-agent run projection", async () => {
+    const [companyA] = await db.insert(companies).values({
+      name: "Run Read A",
+      issuePrefix: "RRA" + randomUUID().slice(0, 5).toUpperCase(),
+    }).returning();
+    const [companyB] = await db.insert(companies).values({
+      name: "Run Read B",
+      issuePrefix: "RRB" + randomUUID().slice(0, 5).toUpperCase(),
+    }).returning();
+    const [agentA] = await db.insert(agents).values({
+      companyId: companyA!.id,
+      name: "Agent A",
+      role: "operator",
+      adapterType: "process",
+      adapterConfig: {},
+      permissions: {},
+    }).returning();
+    const [agentB] = await db.insert(agents).values({
+      companyId: companyB!.id,
+      name: "Agent B",
+      role: "operator",
+      adapterType: "process",
+      adapterConfig: {},
+      permissions: {},
+    }).returning();
+
+    const [run] = await db.insert(heartbeatRuns).values({
+      companyId: companyA!.id,
+      agentId: agentA!.id,
+      status: "succeeded",
+      invocationSource: "automation",
+      resultJson: {
+        model: "wandora-deterministic-read-v1",
+        summary: "bounded result",
+        executionId: "fast_fixture",
+        stdout: "must-not-cross",
+        internalProviderMetadata: { secret: "must-not-cross" },
+      },
+      usageJson: {
+        inputTokens: 0,
+        outputTokens: 0,
+        cachedInputTokens: 0,
+        totalTokens: 0,
+        providerPrivateUsage: "must-not-cross",
+      },
+    }).returning();
+
+    const services = buildHostServices(
+      db,
+      "plugin-record-id",
+      "run-read-test",
+      createEventBusStub(),
+    );
+    try {
+      const result = await services.agentRuns.get({
+        companyId: companyA!.id,
+        agentId: agentA!.id,
+        runId: run!.id,
+      });
+      expect(result).toEqual({
+        runId: run!.id,
+        status: "succeeded",
+        result: {
+          model: "wandora-deterministic-read-v1",
+          summary: "bounded result",
+          executionId: "fast_fixture",
+        },
+        usage: {
+          inputTokens: 0,
+          outputTokens: 0,
+          cachedInputTokens: 0,
+          totalTokens: 0,
+        },
+      });
+      expect(JSON.stringify(result)).not.toMatch(
+        /stdout|secret|internalProviderMetadata|providerPrivateUsage|logRef|processPid|contextSnapshot/,
+      );
+
+      await expect(services.agentRuns.get({
+        companyId: companyB!.id,
+        agentId: agentB!.id,
+        runId: run!.id,
+      })).resolves.toBeNull();
+      await expect(services.agentRuns.get({
+        companyId: companyA!.id,
+        agentId: agentB!.id,
+        runId: run!.id,
+      })).resolves.toBeNull();
+    } finally {
+      services.dispose();
+    }
+  });
+
+  it("returns status only while a run is non-terminal", async () => {
+    const company = await db.select().from(companies).limit(1).then(rows => rows[0]!);
+    const agent = await db.select().from(agents).where(eq(agents.companyId, company.id)).limit(1).then(rows => rows[0]!);
+    const [run] = await db.insert(heartbeatRuns).values({
+      companyId: company.id,
+      agentId: agent.id,
+      status: "running",
+      invocationSource: "automation",
+      resultJson: { model: "partial", summary: "partial" },
+      usageJson: { inputTokens: 12, outputTokens: 3 },
+    }).returning();
+    const services = buildHostServices(db, "plugin-record-id", "run-read-test", createEventBusStub());
+    try {
+      await expect(services.agentRuns.get({
+        companyId: company.id,
+        agentId: agent.id,
+        runId: run!.id,
+      })).resolves.toEqual({
+        runId: run!.id,
+        status: "running",
+        result: null,
+        usage: null,
+      });
+    } finally {
+      services.dispose();
+    }
+  });
+});
