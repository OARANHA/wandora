+    agentRuns: {
+      async get(params) {
+        const companyId = ensureCompanyId(params.companyId);
+        await ensurePluginAvailableForCompany(companyId);
+
+        const agent = await agents.getById(params.agentId);
+        if (!agent || agent.companyId !== companyId) return null;
+
+        const run = await heartbeat.getRun(params.runId);
+        if (!run || run.companyId !== companyId || run.agentId !== agent.id) {
+          return null;
+        }
+
+        const status = (() => {
+          switch (run.status) {
+            case "queued": return "queued" as const;
+            case "running": return "running" as const;
+            case "scheduled_retry": return "scheduled_retry" as const;
+            case "succeeded": return "succeeded" as const;
+            case "interrupted": return "interrupted" as const;
+            case "failed": return "failed" as const;
+            case "cancelled": return "cancelled" as const;
+            case "timed_out": return "timed_out" as const;
+            default: return null;
+          }
+        })();
+        if (!status) return null;
+
+        const terminal =
+          status === "succeeded"
+          || status === "interrupted"
+          || status === "failed"
+          || status === "cancelled"
+          || status === "timed_out";
+        if (!terminal) {
+          return {
+            runId: run.id,
+            status,
+            result: null,
+            usage: null,
+          };
+        }
+
+        const resultJson =
+          run.resultJson && typeof run.resultJson === "object" && !Array.isArray(run.resultJson)
+            ? run.resultJson as Record<string, unknown>
+            : {};
+        const usageJson =
+          run.usageJson && typeof run.usageJson === "object" && !Array.isArray(run.usageJson)
+            ? run.usageJson as Record<string, unknown>
+            : {};
+        const boundedText = (value: unknown, max: number) => {
+          if (typeof value !== "string") return null;
+          const normalized = value.trim();
+          return normalized && normalized.length <= max ? normalized : null;
+        };
+        const tokenCount = (value: unknown) =>
+          typeof value === "number" && Number.isFinite(value) && value >= 0
+            ? Math.floor(value)
+            : 0;
+        const model = boundedText(resultJson.model, 160);
+        const summary = boundedText(resultJson.summary, 12_000);
+        const executionId = boundedText(resultJson.executionId, 255);
+        const inputTokens = tokenCount(usageJson.inputTokens);
+        const outputTokens = tokenCount(usageJson.outputTokens);
+        const cachedInputTokens = tokenCount(usageJson.cachedInputTokens);
+        const totalTokens = tokenCount(
+          usageJson.totalTokens ?? inputTokens + outputTokens + cachedInputTokens,
+        );
+
+        return {
+          runId: run.id,
+          status,
+          result: model && summary
+            ? { model, summary, executionId }
+            : null,
+          usage: {
+            inputTokens,
+            outputTokens,
+            cachedInputTokens,
+            totalTokens,
+          },
+        };
+      },
+    },
