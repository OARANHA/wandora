@@ -0,0 +1,33 @@
+export interface DynamicManagedAgentMarker {
+  pluginKey: string;
+  resourceKey: string;
+  creationFingerprint: string;
+}
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+export function readDynamicManagedAgentMarker(metadata: unknown): DynamicManagedAgentMarker | null {
+  if (!isRecord(metadata)) return null;
+  const marker = metadata.paperclipDynamicManagedAgent;
+  if (!isRecord(marker)) return null;
+  const pluginKey = typeof marker.pluginKey === "string" ? marker.pluginKey : null;
+  const resourceKey = typeof marker.resourceKey === "string" ? marker.resourceKey : null;
+  const creationFingerprint = typeof marker.creationFingerprint === "string" ? marker.creationFingerprint : null;
+  if (!pluginKey || !resourceKey || !creationFingerprint || !/^sha256:[0-9a-f]{64}$/.test(creationFingerprint)) return null;
+  return { pluginKey, resourceKey, creationFingerprint };
+}
+export function withDynamicManagedAgentMarker(
+  metadata: Record<string, unknown> | null | undefined,
+  marker: DynamicManagedAgentMarker,
+): Record<string, unknown> {
+  return { ...(metadata ?? {}), paperclipDynamicManagedAgent: marker };
+}
+export function dynamicManagedAgentMarkersEqual(
+  left: DynamicManagedAgentMarker | null,
+  right: DynamicManagedAgentMarker | null,
+): boolean {
+  if (!left || !right) return left === right;
+  return left.pluginKey === right.pluginKey
+    && left.resourceKey === right.resourceKey
+    && left.creationFingerprint === right.creationFingerprint;
+}
diff --git a/server/src/services/plugin-dynamic-managed-agents.ts b/server/src/services/plugin-dynamic-managed-agents.ts
new file mode 100644
--- /dev/null
+++ b/server/src/services/plugin-dynamic-managed-agents.ts
@@ -0,0 +1,214 @@
+import { createHash } from "node:crypto";
+import { and, eq, inArray, sql } from "drizzle-orm";
+import type { Db } from "@paperclipai/db";
+import { agents, approvals, companies, pluginManagedResources } from "@paperclipai/db";
+import type { Agent } from "@paperclipai/shared";
+import type { PluginDynamicManagedAgentEnsureInput, PluginDynamicManagedAgentResolution, PluginDynamicManagedAgentSpec } from "@paperclipai/plugin-sdk";
+import { conflict, notFound, unprocessable } from "../errors.js";
+import { agentService } from "./agents.js";
+import { approvalService } from "./approvals.js";
+import { logActivity } from "./activity-log.js";
+import { readDynamicManagedAgentMarker, withDynamicManagedAgentMarker } from "./dynamic-managed-agent-metadata.js";
+import { stockHash } from "./managed-resource-drift.js";
+
+const DYNAMIC_BINDING_PREFIX = "$dynamic-agent$:";
+const BINDING_UNIQUE_CONSTRAINT = "plugin_managed_resources_company_plugin_resource_uq";
+const MAX_RESOURCE_KEY_CHARS = 200;
+const MAX_SPEC_BYTES = 64 * 1024;
+interface Options { pluginId: string; pluginKey: string; }
+interface PreparedEnsure {
+  companyId: string; resourceKey: string; bindingResourceKey: string;
+  spec: Required<Pick<PluginDynamicManagedAgentSpec, "name" | "role" | "title" | "icon" | "capabilities" | "adapterType" | "adapterConfig" | "runtimeConfig" | "permissions" | "budgetMonthlyCents">>;
+  creationFingerprint: string;
+}
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+function boundedText(value: unknown, field: string, max: number, options: { nullable?: boolean; defaultValue?: string } = {}): string | null {
+  if (value == null || value === "") {
+    if (options.nullable) return null;
+    if (options.defaultValue !== undefined) return options.defaultValue;
+    throw unprocessable(field + " is required");
+  }
+  if (typeof value !== "string") throw unprocessable(field + " must be a string");
+  const normalized = value.trim();
+  if (!normalized) {
+    if (options.nullable) return null;
+    if (options.defaultValue !== undefined) return options.defaultValue;
+    throw unprocessable(field + " is required");
+  }
+  if (normalized.length > max) throw unprocessable(field + " is too long");
+  return normalized;
+}
+function jsonRecord(value: unknown, field: string): Record<string, unknown> {
+  if (value == null) return {};
+  if (!isRecord(value)) throw unprocessable(field + " must be an object");
+  let serialized: string;
+  try { serialized = JSON.stringify(value); } catch { throw unprocessable(field + " must contain JSON values only"); }
+  if (!serialized || Buffer.byteLength(serialized, "utf8") > MAX_SPEC_BYTES) throw unprocessable(field + " is too large");
+  return JSON.parse(serialized) as Record<string, unknown>;
+}
+function prepare(input: PluginDynamicManagedAgentEnsureInput): PreparedEnsure {
+  const companyId = boundedText(input.companyId, "companyId", 200) as string;
+  const resourceKey = boundedText(input.resourceKey, "resourceKey", MAX_RESOURCE_KEY_CHARS) as string;
+  if (!input.spec || typeof input.spec !== "object") throw unprocessable("spec is required");
+  const spec = {
+    name: boundedText(input.spec.name, "spec.name", 100) as string,
+    role: boundedText(input.spec.role, "spec.role", 100, { defaultValue: "general" }) as string,
+    title: boundedText(input.spec.title, "spec.title", 200, { nullable: true }),
+    icon: boundedText(input.spec.icon, "spec.icon", 500, { nullable: true }),
+    capabilities: boundedText(input.spec.capabilities, "spec.capabilities", 4_000, { nullable: true }),
+    adapterType: boundedText(input.spec.adapterType, "spec.adapterType", 100, { defaultValue: "process" }) as string,
+    adapterConfig: jsonRecord(input.spec.adapterConfig, "spec.adapterConfig"),
+    runtimeConfig: jsonRecord(input.spec.runtimeConfig, "spec.runtimeConfig"),
+    permissions: jsonRecord(input.spec.permissions, "spec.permissions"),
+    budgetMonthlyCents: input.spec.budgetMonthlyCents ?? 0,
+  };
+  if (typeof spec.budgetMonthlyCents !== "number" || !Number.isSafeInteger(spec.budgetMonthlyCents)
+      || spec.budgetMonthlyCents < 0 || spec.budgetMonthlyCents > 1_000_000_000) {
+    throw unprocessable("spec.budgetMonthlyCents must be a non-negative safe integer");
+  }
+  if (Buffer.byteLength(JSON.stringify(spec), "utf8") > MAX_SPEC_BYTES) throw unprocessable("spec is too large");
+  return {
+    companyId, resourceKey,
+    bindingResourceKey: DYNAMIC_BINDING_PREFIX + createHash("sha256").update(resourceKey).digest("hex"),
+    spec, creationFingerprint: stockHash(spec),
+  };
+}
+function isBindingUniqueConflict(error: unknown): boolean {
+  if (!error || typeof error !== "object") return false;
+  const c = error as { code?: string; constraint?: string; constraint_name?: string };
+  return c.code === "23505" && (c.constraint ?? c.constraint_name) === BINDING_UNIQUE_CONSTRAINT;
+}
+export function pluginDynamicManagedAgentService(db: Db, options: Options) {
+  async function markerCandidates(txDb: Db, p: PreparedEnsure) {
+    const rows = await txDb.select().from(agents).where(eq(agents.companyId, p.companyId));
+    return rows.filter((row) => {
+      const marker = readDynamicManagedAgentMarker(row.metadata);
+      return marker?.pluginKey === options.pluginKey && marker.resourceKey === p.resourceKey;
+    });
+  }
+  async function binding(txDb: Db, p: PreparedEnsure) {
+    return txDb.select().from(pluginManagedResources).where(and(
+      eq(pluginManagedResources.companyId, p.companyId), eq(pluginManagedResources.pluginId, options.pluginId),
+      eq(pluginManagedResources.resourceKind, "agent"), eq(pluginManagedResources.resourceKey, p.bindingResourceKey),
+    )).then((rows) => rows[0] ?? null);
+  }
+  async function openHireApprovals(txDb: Db, p: PreparedEnsure, agentId: string) {
+    const rows = await txDb.select().from(approvals).where(and(
+      eq(approvals.companyId, p.companyId), eq(approvals.type, "hire_agent"),
+      inArray(approvals.status, ["pending", "revision_requested"]),
+    ));
+    return rows.filter((row) => (isRecord(row.payload) ? row.payload.agentId : null) === agentId);
+  }
+  function defaultsJson(p: PreparedEnsure) {
+    return { dynamicManagedAgent: true, resourceKey: p.resourceKey, creationFingerprint: p.creationFingerprint, requestedSpec: p.spec };
+  }
+  async function ensureBinding(txDb: Db, p: PreparedEnsure, agent: Agent) {
+    const current = await binding(txDb, p);
+    if (!current) {
+      await txDb.insert(pluginManagedResources).values({
+        companyId: p.companyId, pluginId: options.pluginId, pluginKey: options.pluginKey,
+        resourceKind: "agent", resourceKey: p.bindingResourceKey, resourceId: agent.id, defaultsJson: defaultsJson(p),
+      });
+      return;
+    }
+    if (current.resourceId !== agent.id) {
+      const other = await agentService(txDb).getById(current.resourceId) as Agent | null;
+      if (other && other.status !== "terminated") throw conflict("Dynamic managed agent binding points to another live Agent", {
+        code: "dynamic_managed_agent_binding_conflict", resourceKey: p.resourceKey,
+      });
+    }
+    await txDb.update(pluginManagedResources).set({ resourceId: agent.id, defaultsJson: defaultsJson(p), updatedAt: new Date() })
+      .where(eq(pluginManagedResources.id, current.id));
+  }
+  function resolution(p: PreparedEnsure, agent: Agent, status: PluginDynamicManagedAgentResolution["status"], approvalId: string | null): PluginDynamicManagedAgentResolution {
+    return { pluginKey: options.pluginKey, resourceKind: "agent", resourceKey: p.resourceKey, companyId: p.companyId,
+      agentId: agent.id, agent, status, approvalId, creationFingerprint: p.creationFingerprint };
+  }
+  async function resolveLocked(txDb: Db, p: PreparedEnsure, allowCreate: boolean): Promise<PluginDynamicManagedAgentResolution> {
+    const company = await txDb.select().from(companies).where(eq(companies.id, p.companyId)).then((rows) => rows[0] ?? null);
+    if (!company) throw notFound("Company not found");
+    const candidates = await markerCandidates(txDb, p);
+    if (candidates.length > 1) throw conflict("Dynamic managed agent state is ambiguous", {
+      code: "dynamic_managed_agent_state_ambiguous", resourceKey: p.resourceKey,
+    });
+    const currentBinding = await binding(txDb, p);
+    const rawExisting = candidates[0] ?? null;
+    if (rawExisting) {
+      const marker = readDynamicManagedAgentMarker(rawExisting.metadata)!;
+      if (marker.creationFingerprint !== p.creationFingerprint) throw conflict("Dynamic managed agent creation spec conflicts with existing resource", {
+        code: "dynamic_managed_agent_spec_conflict", resourceKey: p.resourceKey,
+      });
+      if (rawExisting.status === "terminated") throw conflict("Dynamic managed agent is terminated", {
+        code: "dynamic_managed_agent_terminated", resourceKey: p.resourceKey,
+      });
+      const agent = await agentService(txDb).getById(rawExisting.id) as Agent | null;
+      if (!agent) throw conflict("Dynamic managed agent could not be resolved");
+      let approvalId: string | null = null;
+      if (agent.status === "pending_approval") {
+        const open = await openHireApprovals(txDb, p, agent.id);
+        if (open.length !== 1) throw conflict("Dynamic managed agent approval state is inconsistent", {
+          code: "dynamic_managed_agent_approval_inconsistent", resourceKey: p.resourceKey, openApprovalCount: open.length,
+        });
+        approvalId = open[0]!.id;
+      }
+      await ensureBinding(txDb, p, agent);
+      return resolution(p, agent, "resolved", approvalId);
+    }
+    if (currentBinding) throw conflict("Dynamic managed agent binding exists without its provider marker", {
+      code: "dynamic_managed_agent_binding_orphaned", resourceKey: p.resourceKey,
+    });
+    if (!allowCreate) throw conflict("Concurrent dynamic managed agent winner could not be resolved", {
+      code: "dynamic_managed_agent_convergence_failed", resourceKey: p.resourceKey,
+    });
+    const requiresApproval = company.requireBoardApprovalForNewAgents;
+    const marker = { pluginKey: options.pluginKey, resourceKey: p.resourceKey, creationFingerprint: p.creationFingerprint };
+    const created = await agentService(txDb).create(p.companyId, {
+      name: p.spec.name, role: p.spec.role, title: p.spec.title, icon: p.spec.icon,
+      status: requiresApproval ? "pending_approval" : "idle", reportsTo: null, capabilities: p.spec.capabilities,
+      adapterType: p.spec.adapterType, adapterConfig: p.spec.adapterConfig, runtimeConfig: p.spec.runtimeConfig,
+      permissions: p.spec.permissions, budgetMonthlyCents: p.spec.budgetMonthlyCents, spentMonthlyCents: 0,
+      pauseReason: null, pausedAt: null, metadata: withDynamicManagedAgentMarker(null, marker), lastHeartbeatAt: null,
+    }, { allowDynamicManagedAgentMetadata: true }) as Agent;
+    let approvalId: string | null = null;
+    if (requiresApproval) {
+      const approval = await approvalService(txDb).create(p.companyId, {
+        type: "hire_agent", requestedByAgentId: null, requestedByUserId: null, status: "pending",
+        payload: {
+          name: created.name, role: created.role, title: created.title, icon: created.icon, reportsTo: created.reportsTo,
+          capabilities: created.capabilities, adapterType: created.adapterType, adapterConfig: created.adapterConfig,
+          runtimeConfig: created.runtimeConfig, permissions: created.permissions, budgetMonthlyCents: created.budgetMonthlyCents,
+          metadata: created.metadata, agentId: created.id, sourcePluginId: options.pluginId, sourcePluginKey: options.pluginKey,
+          dynamicManagedResourceKey: p.resourceKey, creationFingerprint: p.creationFingerprint,
+        },
+        decisionNote: null, decidedByUserId: null, decidedAt: null, updatedAt: new Date(),
+      });
+      approvalId = approval.id;
+      await logActivity(txDb, { companyId: p.companyId, actorType: "plugin", actorId: options.pluginId,
+        action: "approval.created", entityType: "approval", entityId: approval.id,
+        details: { type: "hire_agent", linkedAgentId: created.id, sourcePluginKey: options.pluginKey, dynamicManagedResourceKey: p.resourceKey } });
+    }
+    await ensureBinding(txDb, p, created);
+    await logActivity(txDb, { companyId: p.companyId, actorType: "plugin", actorId: options.pluginId,
+      action: "plugin.dynamic_managed_agent.created", entityType: "agent", entityId: created.id,
+      details: { sourcePluginKey: options.pluginKey, dynamicManagedResourceKey: p.resourceKey,
+        creationFingerprint: p.creationFingerprint, requiresApproval, approvalId } });
+    return resolution(p, created, "created", approvalId);
+  }
+  async function execute(p: PreparedEnsure, allowCreate: boolean) {
+    return db.transaction(async (tx) => {
+      const txDb = tx as unknown as Db;
+      const lockKey = "paperclip:plugin-dynamic-agent:" + p.companyId + ":" + options.pluginKey + ":" + p.resourceKey;
+      await txDb.execute(sql`select pg_advisory_xact_lock(hashtextextended(${lockKey}, 0))`);
+      return resolveLocked(txDb, p, allowCreate);
+    });
+  }
+  return {
+    ensure: async (input: PluginDynamicManagedAgentEnsureInput) => {
+      const p = prepare(input);
+      try { return await execute(p, true); }
+      catch (error) { if (!isBindingUniqueConflict(error)) throw error; return execute(p, false); }
+    },
+  };
+}
