     expect(list).not.toHaveBeenCalled();
   });
 });
+
+
+describe("toolAccess operational read capability", () => {
+  const snapshot = {
+    companyId: "company-a",
+    agentId: null,
+    runtime: {
+      status: "ok" as const,
+      generatedAt: "2026-09-25T00:00:00.000Z",
+      activeConnections: 1,
+      disabledConnections: 0,
+      degradedConnections: 0,
+      auditWriteFailuresLastHour: 0,
+    },
+    effectiveToolNames: null,
+    connections: [],
+  };
+
+  it("requires the explicit tools.operational.read capability", async () => {
+    const readOperationalSnapshot = vi.fn(async () => snapshot);
+    const handlers = createHostClientHandlers({
+      pluginId: "paperclip.test",
+      capabilities: [],
+      services: {
+        toolAccess: { readOperationalSnapshot },
+      } as unknown as HostServices,
+    });
+
+    await expect(
+      handlers["toolAccess.readOperationalSnapshot"](
+        { companyId: "company-a" },
+        { invocationScope: { companyId: "company-a" } },
+      ),
+    ).rejects.toBeInstanceOf(CapabilityDeniedError);
+    expect(readOperationalSnapshot).not.toHaveBeenCalled();
+  });
+
+  it("rejects cross-company reads before the service is called", async () => {
+    const readOperationalSnapshot = vi.fn(async () => snapshot);
+    const handlers = createHostClientHandlers({
+      pluginId: "paperclip.test",
+      capabilities: ["tools.operational.read"],
+      services: {
+        toolAccess: { readOperationalSnapshot },
+      } as unknown as HostServices,
+    });
+
+    await expect(
+      handlers["toolAccess.readOperationalSnapshot"](
+        { companyId: "company-b" },
+        { invocationScope: { companyId: "company-a" } },
+      ),
+    ).rejects.toBeInstanceOf(InvocationScopeDeniedError);
+    expect(readOperationalSnapshot).not.toHaveBeenCalled();
+  });
+
+  it("allows the bounded read only inside the host-issued company scope", async () => {
+    const readOperationalSnapshot = vi.fn(async () => snapshot);
+    const handlers = createHostClientHandlers({
+      pluginId: "paperclip.test",
+      capabilities: ["tools.operational.read"],
+      services: {
+        toolAccess: { readOperationalSnapshot },
+      } as unknown as HostServices,
+    });
+
+    await expect(
+      handlers["toolAccess.readOperationalSnapshot"](
+        { companyId: "company-a" },
+        { invocationScope: { companyId: "company-a" } },
+      ),
+    ).resolves.toEqual(snapshot);
+    expect(readOperationalSnapshot).toHaveBeenCalledWith({ companyId: "company-a" });
+  });
+});
