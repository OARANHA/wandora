index 000000000..aa6dd63ed
--- /dev/null
+++ b/server/src/__tests__/plugin-tool-access-operational-read.test.ts
@@ -0,0 +1,229 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  agents,
+  companies,
+  connectionGrants,
+  createDb,
+  toolApplications,
+  toolCatalogEntries,
+  toolConnectionInstalls,
+  toolConnections,
+  toolProfileBindings,
+  toolProfileEntries,
+  toolProfiles,
+} from "@paperclipai/db";
+import { buildHostServices } from "../services/plugin-host-services.js";
+import {
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "./helpers/embedded-postgres.js";
+
+function createEventBusStub() {
+  return {
+    forPlugin() {
+      return {
+        emit: vi.fn(),
+        subscribe: vi.fn(),
+        clear: vi.fn(),
+      };
+    },
+  } as any;
+}
+
+const embeddedPostgresSupport = await getEmbeddedPostgresTestSupport();
+const describeEmbeddedPostgres = embeddedPostgresSupport.supported ? describe : describe.skip;
+
+async function seedCompany(db: ReturnType<typeof createDb>, prefix: string) {
+  return db
+    .insert(companies)
+    .values({
+      name: prefix,
+      issuePrefix: prefix.slice(0, 3).toUpperCase() + randomUUID().slice(0, 5).toUpperCase(),
+    })
+    .returning()
+    .then((rows) => rows[0]!);
+}
+
+async function seedAgent(db: ReturnType<typeof createDb>, companyId: string, name: string) {
+  return db
+    .insert(agents)
+    .values({
+      companyId,
+      name,
+      role: "operator",
+      adapterType: "process",
+      adapterConfig: {},
+      permissions: {},
+    })
+    .returning()
+    .then((rows) => rows[0]!);
+}
+
+async function seedOperationalTool(
+  db: ReturnType<typeof createDb>,
+  companyId: string,
+  agentId: string,
+  suffix: string,
+) {
+  const [application] = await db
+    .insert(toolApplications)
+    .values({
+      companyId,
+      applicationKey: `fixture-${suffix}`,
+      name: `Fixture App ${suffix}`,
+      type: "mcp_http",
+      status: "active",
+    })
+    .returning();
+  const [connection] = await db
+    .insert(toolConnections)
+    .values({
+      companyId,
+      applicationId: application!.id,
+      name: `Fixture Connection ${suffix}`,
+      uid: `fixture/${randomUUID()}`,
+      transport: "mcp_remote",
+      status: "active",
+      enabled: true,
+      config: { url: "https://fixture.example.test/mcp" },
+      transportConfig: { url: "https://fixture.example.test/mcp" },
+      healthStatus: "ok",
+      credentialPolicy: "shared",
+      lastCatalogRefreshAt: new Date(0),
+    })
+    .returning();
+  await db.insert(connectionGrants).values({
+    companyId,
+    connectionId: connection!.id,
+    kind: "organization",
+    credentialSecretRefs: [],
+    status: "active",
+    isDefault: true,
+  });
+  const [catalogEntry] = await db
+    .insert(toolCatalogEntries)
+    .values({
+      companyId,
+      applicationId: application!.id,
+      connectionId: connection!.id,
+      entryKind: "tool",
+      name: `lookup-${suffix}`,
+      toolName: `lookup_${suffix}`,
+      riskLevel: "read",
+      isReadOnly: true,
+      isWrite: false,
+      isDestructive: false,
+      status: "active",
+      versionHash: randomUUID(),
+      schemaHash: randomUUID(),
+    })
+    .returning();
+  await db.insert(toolConnectionInstalls).values({
+    companyId,
+    connectionId: connection!.id,
+    targetType: "agent",
+    targetId: agentId,
+  });
+  const [profile] = await db
+    .insert(toolProfiles)
+    .values({
+      companyId,
+      profileKey: `profile-${suffix}-${randomUUID()}`,
+      name: `Profile ${suffix}`,
+      defaultAction: "deny",
+    })
+    .returning();
+  await db.insert(toolProfileBindings).values({
+    companyId,
+    profileId: profile!.id,
+    targetType: "agent",
+    targetId: agentId,
+  });
+  await db.insert(toolProfileEntries).values({
+    companyId,
+    profileId: profile!.id,
+    selectorType: "connection",
+    effect: "include",
+    connectionId: connection!.id,
+  });
+  return { application: application!, connection: connection!, catalogEntry: catalogEntry! };
+}
+
+describeEmbeddedPostgres("plugin Tool Access operational read boundary", () => {
+  let db!: ReturnType<typeof createDb>;
+  let tempDb: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    tempDb = await startEmbeddedPostgresTestDatabase("paperclip-plugin-tool-access-read-");
+    db = createDb(tempDb.connectionString);
+  }, 20_000);
+
+  afterAll(async () => {
+    await tempDb?.cleanup();
+  });
+
+  it("returns a bounded company+agent projection without IDs or credential material", async () => {
+    const companyA = await seedCompany(db, "Operational Read A");
+    const companyB = await seedCompany(db, "Operational Read B");
+    const agentA = await seedAgent(db, companyA.id, "Agent A");
+    const agentB = await seedAgent(db, companyB.id, "Agent B");
+    const a = await seedOperationalTool(db, companyA.id, agentA.id, "a");
+    await seedOperationalTool(db, companyB.id, agentB.id, "b");
+
+    const services = buildHostServices(
+      db,
+      "plugin-record-id",
+      "operational-read-test",
+      createEventBusStub(),
+    );
+    try {
+      const snapshot = await services.toolAccess.readOperationalSnapshot({
+        companyId: companyA.id,
+        agentId: agentA.id,
+      });
+
+      expect(snapshot.runtimeHealth).toMatch(/^(ok|degraded|critical)$/);
+      expect(snapshot.connections).toEqual([
+        expect.objectContaining({
+          displayName: "Fixture App a",
+          status: "active",
+          enabled: true,
+          healthStatus: "ok",
+          organizationGrantActive: true,
+          installedForAgent: true,
+          tools: [
+            expect.objectContaining({
+              toolName: "lookup_a",
+              status: "active",
+              riskLevel: "read",
+              isReadOnly: true,
+              isWrite: false,
+              isDestructive: false,
+              allowedByEffectiveProfile: true,
+            }),
+          ],
+        }),
+      ]);
+
+      const serialized = JSON.stringify(snapshot);
+      expect(serialized).not.toContain(companyA.id);
+      expect(serialized).not.toContain(companyB.id);
+      expect(serialized).not.toContain(agentA.id);
+      expect(serialized).not.toContain(agentB.id);
+      expect(serialized).not.toContain(a.application.id);
+      expect(serialized).not.toContain(a.connection.id);
+      expect(serialized).not.toContain(a.catalogEntry.id);
+      expect(serialized).not.toMatch(/credential|secretRef|grantId|profileId|catalogEntryId|connectionId/i);
+
+      await expect(
+        services.toolAccess.readOperationalSnapshot({
+          companyId: companyA.id,
+          agentId: agentB.id,
+        }),
+      ).rejects.toThrow("Agent not found");
+    } finally {
+      services.dispose();
+    }
+  });
+});
