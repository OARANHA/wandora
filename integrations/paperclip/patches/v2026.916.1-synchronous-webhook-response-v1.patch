@@ -0,0 +1,151 @@
+import { createInterface } from "node:readline";
+import { PassThrough } from "node:stream";
+
+import { describe, expect, it } from "vitest";
+
+import {
+  definePlugin,
+  PLUGIN_WEBHOOK_RESPONSE_MAX_BYTES,
+  type PaperclipPlugin,
+} from "../src/index.js";
+import {
+  createRequest,
+  isJsonRpcResponse,
+  parseMessage,
+  serializeMessage,
+  type JsonRpcResponse,
+} from "../src/protocol.js";
+import { startWorkerRpcHost } from "../src/worker-rpc-host.js";
+
+const webhookInput = {
+  endpointKey: "sync",
+  headers: { "content-type": "application/json" },
+  rawBody: "{}",
+  parsedBody: {},
+  requestId: "request-1",
+};
+
+function startClient(plugin: PaperclipPlugin) {
+  const hostToWorker = new PassThrough();
+  const workerToHost = new PassThrough();
+  const hostReadline = createInterface({ input: workerToHost });
+  const pending = new Map<string, (response: JsonRpcResponse) => void>();
+  let nextRequestId = 1;
+  const worker = startWorkerRpcHost({
+    plugin,
+    stdin: hostToWorker,
+    stdout: workerToHost,
+  });
+
+  function callWorker(method: string, params: unknown) {
+    const id = `host-${nextRequestId++}`;
+    const result = new Promise<unknown>((resolve, reject) => {
+      pending.set(id, (response) => {
+        if ("error" in response && response.error) {
+          reject(new Error(response.error.message));
+          return;
+        }
+        resolve((response as { result?: unknown }).result);
+      });
+    });
+    hostToWorker.write(serializeMessage(createRequest(method, params, id)));
+    return result;
+  }
+
+  hostReadline.on("line", (line) => {
+    const message = parseMessage(line);
+    if (!isJsonRpcResponse(message)) return;
+    pending.get(String(message.id))?.(message);
+    pending.delete(String(message.id));
+  });
+
+  return {
+    callWorker,
+    close() {
+      worker.stop();
+      hostReadline.close();
+      hostToWorker.destroy();
+      workerToHost.destroy();
+    },
+  };
+}
+
+async function initialize(callWorker: (method: string, params: unknown) => Promise<unknown>) {
+  await expect(callWorker("initialize", {
+    manifest: {
+      id: "paperclip.test-webhook-response",
+      apiVersion: 1,
+      version: "1.0.0",
+      displayName: "Webhook Response Test",
+      description: "Test plugin",
+      author: "Paperclip",
+      categories: ["automation"],
+      capabilities: ["webhooks.receive"],
+      entrypoints: {},
+    },
+    config: {},
+    databaseNamespace: null,
+  })).resolves.toMatchObject({ ok: true });
+}
+
+describe("worker webhook response contract", () => {
+  it("preserves legacy void handlers as a null wire result", async () => {
+    const client = startClient(definePlugin({
+      async setup() {},
+      async onWebhook() {},
+    }));
+    try {
+      await initialize(client.callWorker);
+      await expect(client.callWorker("handleWebhook", webhookInput)).resolves.toBeNull();
+    } finally {
+      client.close();
+    }
+  });
+
+  it("propagates a bounded JSON object synchronously", async () => {
+    const client = startClient(definePlugin({
+      async setup() {},
+      async onWebhook() {
+        return {
+          runId: "run-1",
+          evidence: { accepted: true },
+        };
+      },
+    }));
+    try {
+      await initialize(client.callWorker);
+      await expect(client.callWorker("handleWebhook", webhookInput)).resolves.toEqual({
+        runId: "run-1",
+        evidence: { accepted: true },
+      });
+    } finally {
+      client.close();
+    }
+  });
+
+  it("fails closed for non-JSON values", async () => {
+    const client = startClient(definePlugin({
+      async setup() {},
+      async onWebhook() {
+        return { value: Number.NaN };
+      },
+    }));
+    try {
+      await initialize(client.callWorker);
+      await expect(client.callWorker("handleWebhook", webhookInput))
+        .rejects.toThrow("JSON values only");
+    } finally {
+      client.close();
+    }
+  });
+
+  it("fails closed for oversized responses", async () => {
+    const client = startClient(definePlugin({
+      async setup() {},
+      async onWebhook() {
+        return { payload: "x".repeat(PLUGIN_WEBHOOK_RESPONSE_MAX_BYTES + 1) };
+      },
+    }));
+    try {
+      await initialize(client.callWorker);
+      await expect(client.callWorker("handleWebhook", webhookInput))
+        .rejects.toThrow("too large");
+    } finally {
+      client.close();
+    }
+  });
+});
