+++ b/server/src/__tests__/plugin-webhook-response-routes.test.ts
@@ -0,0 +1,157 @@
+import express from "express";
+import request from "supertest";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { PLUGIN_WEBHOOK_RESPONSE_MAX_BYTES } from "@paperclipai/plugin-sdk";
+
+const mockRegistry = vi.hoisted(() => ({
+  getById: vi.fn(),
+  getByKey: vi.fn(),
+}));
+
+vi.mock("../services/plugin-registry.js", () => ({
+  pluginRegistryService: () => mockRegistry,
+}));
+
+vi.mock("../services/plugin-lifecycle.js", () => ({
+  pluginLifecycleManager: () => ({}),
+}));
+
+vi.mock("../services/activity-log.js", () => ({
+  logActivity: vi.fn(),
+}));
+
+vi.mock("../services/live-events.js", () => ({
+  publishGlobalLiveEvent: vi.fn(),
+}));
+
+const pluginId = "11111111-1111-4111-8111-111111111111";
+const deliveryId = "22222222-2222-4222-8222-222222222222";
+
+function createFakeDb(updates: Array<Record<string, unknown>>) {
+  return {
+    insert: vi.fn(() => ({
+      values: vi.fn(() => ({
+        returning: vi.fn(async () => [{ id: deliveryId }]),
+      })),
+    })),
+    update: vi.fn(() => ({
+      set: vi.fn((value: Record<string, unknown>) => {
+        updates.push(value);
+        return {
+          where: vi.fn(async () => []),
+        };
+      }),
+    })),
+  };
+}
+
+async function createApp(workerResult: unknown) {
+  const { pluginRoutes } = await import("../routes/plugins.js");
+  const updates: Array<Record<string, unknown>> = [];
+  const db = createFakeDb(updates);
+  const workerManager = {
+    call: vi.fn().mockResolvedValue(workerResult),
+  };
+  const app = express();
+  app.use(express.json({
+    verify(req, _res, buffer) {
+      (req as typeof req & { rawBody?: Buffer }).rawBody = Buffer.from(buffer);
+    },
+  }));
+  app.use("/api", pluginRoutes(
+    db as never,
+    {} as never,
+    undefined,
+    { workerManager } as never,
+  ));
+
+  return { app, workerManager, updates };
+}
+
+describe.sequential("plugin webhook synchronous responses", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockRegistry.getById.mockResolvedValue({
+      id: pluginId,
+      pluginKey: "paperclip.test-webhook",
+      version: "1.0.0",
+      status: "ready",
+      manifestJson: {
+        capabilities: ["webhooks.receive"],
+        webhooks: [{ endpointKey: "sync" }],
+      },
+    });
+  });
+
+  it("preserves the legacy acknowledgement for void handlers", async () => {
+    const { app, updates } = await createApp(null);
+    const response = await request(app)
+      .post(`/api/plugins/${pluginId}/webhooks/sync`)
+      .send({ hello: "world" });
+
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({
+      deliveryId,
+      status: "success",
+    });
+    expect(updates).toEqual([
+      expect.objectContaining({ status: "success" }),
+    ]);
+  });
+
+  it("returns a bounded worker JSON object synchronously", async () => {
+    const workerResult = {
+      runId: "run-1",
+      evidence: { accepted: true },
+    };
+    const { app, workerManager, updates } = await createApp(workerResult);
+    const response = await request(app)
+      .post(`/api/plugins/${pluginId}/webhooks/sync`)
+      .send({ hello: "world" });
+
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual(workerResult);
+    expect(workerManager.call).toHaveBeenCalledWith(
+      pluginId,
+      "handleWebhook",
+      expect.objectContaining({
+        endpointKey: "sync",
+        rawBody: JSON.stringify({ hello: "world" }),
+      }),
+    );
+    expect(updates).toEqual([
+      expect.objectContaining({ status: "success" }),
+    ]);
+  });
+
+  it("fails closed if a worker bypasses the SDK response bound", async () => {
+    const { app, updates } = await createApp({
+      payload: "x".repeat(PLUGIN_WEBHOOK_RESPONSE_MAX_BYTES + 1),
+    });
+    const response = await request(app)
+      .post(`/api/plugins/${pluginId}/webhooks/sync`)
+      .send({ hello: "world" });
+
+    expect(response.status).toBe(502);
+    expect(response.body).toEqual(expect.objectContaining({
+      deliveryId,
+      status: "failed",
+      error: expect.stringContaining("too large"),
+    }));
+    expect(updates).toEqual([
+      expect.objectContaining({
+        status: "failed",
+        error: expect.stringContaining("too large"),
+      }),
+    ]);
+  });
+});
