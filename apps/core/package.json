    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pg": "8.15.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
