# Apply these values to the pinned upstream .env after generating real secrets locally.
COMPOSE_FILE=docker-compose.yml:docker-compose.wandora.yml
SUPABASE_PUBLIC_URL=https://supabase.wandora.com.br
API_EXTERNAL_URL=https://supabase.wandora.com.br/auth/v1
SITE_URL=https://app.wandora.com.br
ADDITIONAL_REDIRECT_URLS=https://app.wandora.com.br/**,http://localhost:3000/**,http://localhost:5173/**

STUDIO_DEFAULT_ORGANIZATION=Wandora
STUDIO_DEFAULT_PROJECT=Wandora

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Keep the API gateway reachable only from localhost/Traefik on the host.
API_GW_HTTP_PORT=127.0.0.1:8000
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# Upstream defaults kept explicit for reproducibility.
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,graphql_public

# Do not put any runtime secret in this file.
# Generate POSTGRES_PASSWORD, JWT/JWK keys, dashboard credentials and other secrets on the target host.
